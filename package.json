{
  "name": "skillbridge",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "verify": "rolldown scripts/verify.ts -d .tmpflow -f esm --platform node && node .tmpflow/verify.js",
    "smoke": "rolldown scripts/smoke.tsx -d .tmpflow -f esm --platform node && node .tmpflow/smoke.js",
    "flow": "rolldown scripts/flow.tsx -d .tmpflow -f esm --platform node --external jsdom && node .tmpflow/flow.js"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.40.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "jsdom": "^30.0.1",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.28",
    "rolldown": "^1.2.7",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
